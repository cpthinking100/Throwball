<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Throwball Infinity</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #111827;
            color: white;
            min-height: 100vh;
        }
        
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #1f2937; }
        ::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 4px; }

        canvas {
            display: block;
            margin: 0 auto;
            background: #2d3748;
            border-radius: 0.5rem;
            width: 100%;
            max-width: 1280px;
            aspect-ratio: 1280 / 720;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
        }

        .game-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(0, 0, 0, 0.95);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            overflow-y: auto;
            padding: 2rem 1rem;
            z-index: 50;
        }
        
        .modal-box {
            background-color: #1f2937;
            padding: 1.5rem;
            border-radius: 0.75rem;
            width: 100%;
            max-width: 1400px;
            margin: auto;
            border: 1px solid #374151;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
        }

        .scroll-area {
            max-height: 45vh;
            overflow-y: auto;
            border-top: 1px solid #374151;
            border-bottom: 1px solid #374151;
            padding: 1rem 0.5rem;
            margin: 1rem 0;
        }
        
        select, input[type="number"], input[type="text"] {
            background-color: #374151; color: white; border: 1px solid #4b5563; padding: 0.25rem; border-radius: 0.25rem;
        }

        input[type=number]::-webkit-inner-spin-button, input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
        
        #mobile-controls {
            display: none; 
            position: fixed; bottom: 10px; left: 0; right: 0;
            padding: 0 20px;
            justify-content: space-between;
            z-index: 40;
            user-select: none;
            touch-action: none; 
        }

        .btn-control {
            background: rgba(55, 65, 81, 0.8);
            border: 2px solid #4b5563;
            color: white; font-weight: bold;
            border-radius: 50%;
            width: 60px; height: 60px;
            display: flex; justify-content: center; align-items: center;
            user-select: none; text-transform: uppercase; font-size: 12px;
        }
        .btn-control:active { background: rgba(75, 85, 99, 1); transform: scale(0.95); }
        .d-pad { display: grid; grid-template-columns: repeat(3, 50px); grid-template-rows: repeat(3, 50px); gap: 5px; }
        .action-pad { display: grid; grid-template-columns: repeat(2, 60px); grid-template-rows: repeat(2, 60px); gap: 10px; }

        .btn-toggle-active { background-color: #2563eb !important; border-color: #60a5fa !important; }
    </style>
</head>
<body class="flex flex-col relative pb-12 pt-4">

    <!-- SETUP OVERLAY -->
    <div id="start-overlay" class="game-overlay">
        <div class="modal-box flex flex-col text-center">
            <h1 class="text-4xl font-extrabold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-500 tracking-wider">THROWBALL INFINITY</h1>
            
            <div class="flex justify-center gap-4 mb-4">
                <button onclick="window.toggleTutorial()" class="bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded font-bold text-sm">🎓 How to Play</button>
                <button onclick="window.toggleGuide()" class="bg-purple-600 hover:bg-purple-500 text-white px-4 py-2 rounded font-bold text-sm">📖 Ability Guide</button>
            </div>

            <!-- Mode Selectors -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="bg-gray-800 p-2 rounded-lg border border-gray-700 flex flex-col items-center justify-center">
                    <span class="text-gray-400 text-xs font-bold uppercase tracking-widest mb-1">Network Mode</span>
                    <div class="flex gap-2">
                        <button id="btn-mode-local" onclick="window.setNetMode('local')" class="btn-toggle-active bg-gray-700 px-4 py-1.5 rounded font-bold text-white transition text-sm border border-transparent">Local</button>
                        <button id="btn-mode-host" onclick="window.setNetMode('host')" class="bg-gray-700 px-4 py-1.5 rounded font-bold text-white transition text-sm border border-transparent">Host Online</button>
                        <button id="btn-mode-join" onclick="window.setNetMode('client')" class="bg-gray-700 px-4 py-1.5 rounded font-bold text-white transition text-sm border border-transparent">Join Online</button>
                    </div>
                </div>
                <div class="bg-gray-800 p-2 rounded-lg border border-gray-700 flex flex-col items-center justify-center" id="play-style-container">
                    <span class="text-gray-400 text-xs font-bold uppercase tracking-widest mb-1">Play Style</span>
                    <div class="flex gap-2">
                        <button id="btn-style-team" onclick="window.setPlayStyle('team')" class="btn-toggle-active bg-gray-700 px-4 py-1.5 rounded font-bold text-white transition text-sm border border-transparent">Full Team Control</button>
                        <button id="btn-style-hero" onclick="window.setPlayStyle('hero')" class="bg-gray-700 px-4 py-1.5 rounded font-bold text-white transition text-sm border border-transparent">Hero Mode (Locked)</button>
                    </div>
                </div>
            </div>

            <!-- Host Config / Join Config -->
            <div id="online-host-panel" style="display:none;" class="bg-gray-800 p-3 rounded-lg mb-2 border border-green-500/50">
                <div class="flex flex-col md:flex-row items-center justify-center gap-4">
                    <button id="host-create-btn" class="bg-green-600 hover:bg-green-500 text-white px-6 py-2 rounded font-bold transition shadow-lg">Generate Room Code</button>
                    <p id="host-code-display" class="text-2xl font-mono text-yellow-400 font-bold tracking-widest"></p>
                    <label class="flex items-center space-x-2 cursor-pointer text-gray-300 font-bold text-sm bg-gray-900 p-2 rounded border border-gray-600">
                        <input type="checkbox" id="host-spectate-check" class="w-4 h-4" onchange="window.updateUIState()">
                        <span>Host Spectate Only (No Player)</span>
                    </label>
                </div>
            </div>
            
            <div id="online-join-panel" style="display:none;" class="bg-gray-800 p-3 rounded-lg mb-2 border border-blue-500/50">
                <div class="flex items-center justify-center gap-4">
                    <input type="text" id="join-code-input" placeholder="CODE" maxlength="4" class="text-center uppercase text-black font-bold text-xl p-1.5 w-24 rounded">
                    <button id="join-room-btn" class="bg-blue-600 hover:bg-blue-500 text-white px-6 py-1.5 rounded font-bold transition shadow-lg">Connect to Lobby</button>
                    <p id="join-status-msg" class="text-sm text-yellow-400"></p>
                </div>
            </div>

            <!-- Global Match Settings (Hidden for Joiners) -->
            <div id="global-settings-panel" class="grid grid-cols-2 lg:grid-cols-4 gap-4 bg-gray-700 p-4 rounded-lg mb-2">
                <div class="flex flex-col"><label class="font-bold text-sm text-gray-300">Game Time (mins)</label><input type="number" id="game-time-input" value="3" min="1" max="60" class="text-center font-bold"></div>
                <div class="flex flex-col"><label class="font-bold text-sm text-blue-300">Blue Team Size</label><input type="number" id="blue-size-input" value="5" min="1" max="30" class="text-center font-bold"></div>
                <div class="flex flex-col"><label class="font-bold text-sm text-red-300">Red Team Size</label><input type="number" id="red-size-input" value="5" min="1" max="30" class="text-center font-bold"></div>
                <div class="flex items-end">
                    <label class="flex items-center justify-center w-full h-full space-x-2 cursor-pointer text-yellow-400 font-bold bg-gray-800 rounded border border-yellow-500/50">
                        <input type="checkbox" id="enforce-stats-check" checked class="w-4 h-4 accent-yellow-400">
                        <span class="text-xs">Enforce Stat Cap (350)</span>
                    </label>
                </div>
            </div>

            <!-- FULL TEAM BUILDER PANELS -->
            <div id="builder-team-panel" class="w-full">
                <!-- Local Assignments for Full Team -->
                <div id="local-team-assignments" class="flex justify-center gap-4 mb-2 bg-gray-700 p-2 rounded-lg">
                    <label class="flex items-center space-x-2 text-blue-400 font-bold text-sm">
                        <span>P1 (WASD):</span>
                        <select id="p1-team-select" class="bg-gray-800 text-white rounded p-1 outline-none"><option value="blue" selected>Blue</option><option value="red">Red</option><option value="none">Off</option></select>
                    </label>
                    <label class="flex items-center space-x-2 text-red-400 font-bold text-sm">
                        <span>P2 (ARROWS):</span>
                        <select id="p2-team-select" class="bg-gray-800 text-white rounded p-1 outline-none"><option value="blue">Blue</option><option value="red" selected>Red</option><option value="none">Off</option></select>
                    </label>
                    <button onclick="window.generateFullTeams()" class="bg-gray-600 hover:bg-gray-500 text-white px-4 py-1 rounded font-bold ml-auto text-xs">Re-Generate Lists</button>
                </div>

                <div class="scroll-area">
                    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 text-left pb-4">
                        <div class="flex flex-col gap-2">
                            <div class="bg-gray-800 p-2 rounded border border-blue-900 shadow flex justify-between items-center sticky top-0 z-10">
                                <input type="text" id="blue-team-name-input" value="Blue Team" class="text-lg font-bold text-blue-400 bg-transparent focus:outline-none">
                            </div>
                            <div id="blue-player-list" class="space-y-2"></div>
                        </div>
                        <div class="flex flex-col gap-2">
                            <div class="bg-gray-800 p-2 rounded border border-red-900 shadow flex justify-between items-center sticky top-0 z-10">
                                <input type="text" id="red-team-name-input" value="Red Team" class="text-lg font-bold text-red-400 bg-transparent focus:outline-none">
                            </div>
                            <div id="red-player-list" class="space-y-2"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- HERO BUILDER PANELS -->
            <div id="builder-hero-panel" style="display:none;" class="w-full">
                <div class="scroll-area flex flex-col gap-4 text-left">
                    
                    <div id="hero-p1-wrap" class="bg-gray-700 p-4 rounded-lg border border-blue-500/50">
                        <div class="flex justify-between items-center mb-2 border-b border-gray-600 pb-2">
                            <h2 class="text-lg font-bold text-blue-400">P1 Hero / My Hero</h2>
                            <select id="hero-p1-team" class="bg-gray-800 text-white font-bold p-1 rounded outline-none">
                                <option value="blue" class="text-blue-400">🟦 Blue Team</option><option value="red" class="text-red-400">🟥 Red Team</option>
                            </select>
                        </div>
                        <div id="hero-p1-container"></div>
                    </div>

                    <div id="hero-p2-wrap" class="bg-gray-700 p-4 rounded-lg border border-red-500/50">
                        <div class="flex justify-between items-center mb-2 border-b border-gray-600 pb-2">
                            <h2 class="text-lg font-bold text-red-400">P2 Hero (Local)</h2>
                            <select id="hero-p2-team" class="bg-gray-800 text-white font-bold p-1 rounded outline-none">
                                <option value="blue" class="text-blue-400">🟦 Blue Team</option><option value="red" selected class="text-red-400">🟥 Red Team</option><option value="none" class="text-gray-400">Off (No P2)</option>
                            </select>
                        </div>
                        <div id="hero-p2-container"></div>
                    </div>

                </div>
            </div>

            <!-- Online Lobby Info Display -->
            <div id="online-lobby-display" style="display:none;" class="bg-gray-800 p-3 rounded-lg mb-2 text-left border border-gray-600">
                <h3 class="text-sm font-bold text-yellow-400 border-b border-gray-600 mb-1">Connected Players</h3>
                <ul id="lobby-player-list" class="space-y-1 text-xs font-mono"></ul>
                <div id="lobby-action-container" class="mt-2"></div>
            </div>
            
            <div class="flex-none mt-2 pt-2 flex flex-col md:flex-row gap-4 w-full justify-center items-center">
                <label class="flex items-center space-x-2 cursor-pointer text-purple-400 font-bold text-sm bg-gray-800 p-2 rounded-lg border border-purple-500/30">
                    <input type="checkbox" id="mobile-device-check" class="w-4 h-4 accent-purple-400">
                    <span>Show Mobile Controls</span>
                </label>
                <button id="start-game-btn" class="w-full md:w-1/3 bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 rounded-lg text-xl transition shadow-lg">START LOCAL MATCH</button>
            </div>
            
            <p id="firebase-status" class="text-xs text-gray-500 mt-2">Connecting to multiplayer servers...</p>
        </div>
    </div>

    <!-- TUTORIAL MENU -->
    <div id="tutorial-overlay" class="game-overlay" style="display: none; z-index: 100;">
        <div class="modal-box max-w-3xl text-left relative">
            <button onclick="window.toggleTutorial()" class="absolute top-4 right-4 text-gray-400 hover:text-white text-2xl font-bold">&times;</button>
            <h2 class="text-3xl font-bold text-blue-400 mb-4 border-b border-gray-700 pb-2">How to Play: Throwball Infinity</h2>
            <div class="space-y-4 max-h-[60vh] overflow-y-auto pr-2 text-gray-300 leading-relaxed text-sm">
                <p><span class="font-bold text-white text-lg">The Goal:</span> Pick up the white ball and throw it into the enemy's glowing goal hole to score. The team with the most points when time runs out wins!</p>
                <hr class="border-gray-700">
                <p><span class="font-bold text-yellow-400">Potential Points:</span> If you hold the ball and stand inside the enemy's colored zone (the outer thirds of the court), you will slowly generate <span class="font-bold text-yellow-300">Potential Points</span>. 
                When you throw the ball into the goal, you cash in your Potential Points + 1 standard point. But beware: if the enemy steals the ball, they steal ALL of your Potential Points!</p>
                <hr class="border-gray-700">
                <h3 class="text-xl font-bold text-white">Basic Controls:</h3>
                <ul class="list-disc pl-6 space-y-1">
                    <li><span class="font-mono text-white">WASD / Arrows:</span> Move your character.</li>
                    <li><span class="font-mono text-white">Space / Enter:</span> Throw the ball (if held) OR Steal the ball (if near an enemy holding it).</li>
                    <li><span class="font-mono text-white">Q / Shift:</span> Switch control to the teammate closest to the ball (Full Team Mode only).</li>
                </ul>
                <h3 class="text-xl font-bold text-purple-400 mt-4">Abilities:</h3>
                <ul class="list-disc pl-6 space-y-1">
                    <li><span class="font-mono text-white">E / Slash (/):</span> Activate your equipped Ability.</li>
                    <li><span class="font-mono text-white">C / Period (.):</span> Cycle through your loaded abilities (or discard a copied ability).</li>
                </ul>
                <p class="text-xs text-gray-400 italic">Abilities slowly charge up over time. If you have "Copycat" or "Adaptation", stealing the ball from an enemy grants you their ability! See the "Ability Guide" for details on specific powers.</p>
            </div>
            <div class="mt-6 text-center">
                <button onclick="window.toggleTutorial()" class="bg-blue-600 hover:bg-blue-500 px-8 py-2 rounded font-bold text-white">Got it!</button>
            </div>
        </div>
    </div>

    <!-- PAUSE MENU -->
    <div id="pause-overlay" class="game-overlay" style="display: none;">
        <div class="modal-box text-center max-w-4xl">
            <h1 class="text-4xl font-extrabold text-yellow-400 mb-6">PAUSED</h1>
            <div class="flex justify-center gap-4 mb-6">
                <button onclick="window.togglePause()" class="bg-green-600 hover:bg-green-500 px-6 py-2 rounded font-bold text-lg">Resume Game</button>
                <button onclick="window.toggleGuide()" class="bg-purple-600 hover:bg-purple-500 px-6 py-2 rounded font-bold text-lg">Ability Guide</button>
                <button onclick="window.resetGameState()" class="bg-red-600 hover:bg-red-500 px-6 py-2 rounded font-bold text-lg">Quit to Menu</button>
            </div>
            <div class="grid grid-cols-2 gap-4 text-left text-sm max-h-[50vh] overflow-y-auto">
                <div class="bg-gray-800 p-4 rounded border border-blue-900">
                    <h3 id="pause-blue-name" class="text-xl font-bold text-blue-400 mb-2 border-b border-gray-600 pb-1">Blue Team</h3>
                    <ul id="pause-blue-roster" class="space-y-1"></ul>
                </div>
                <div class="bg-gray-800 p-4 rounded border border-red-900">
                    <h3 id="pause-red-name" class="text-xl font-bold text-red-400 mb-2 border-b border-gray-600 pb-1">Red Team</h3>
                    <ul id="pause-red-roster" class="space-y-1"></ul>
                </div>
            </div>
        </div>
    </div>

    <!-- GUIDE -->
    <div id="guide-overlay" class="game-overlay" style="display: none; z-index: 100;">
        <div class="modal-box max-w-3xl text-left relative">
            <button onclick="window.toggleGuide()" class="absolute top-4 right-4 text-gray-400 hover:text-white text-2xl font-bold">&times;</button>
            <h2 class="text-3xl font-bold text-purple-400 mb-4 border-b border-gray-700 pb-2">Ability Guide</h2>
            <div class="space-y-3 max-h-[60vh] overflow-y-auto pr-2 text-sm text-gray-300">
                <p><span class="font-bold text-blue-400">Speedster / Speedster+:</span> Passively boosts movement speed while active. (+) Much faster.</p>
                <p><span class="font-bold text-blue-400">Magnet / Magnet+:</span> Passively increases ball pickup/steal range. (+) Massive range increase.</p>
                <p><span class="font-bold text-blue-400">Sniper / Sniper+:</span> Passively increases throw speed and accuracy. (+) Ball travels like a bullet.</p>
                <p><span class="font-bold text-blue-400">Tank / Tank+:</span> Passively boosts Keep stat, making it very hard for enemies to steal from you. (+) Almost immune to steals.</p>
                <p><span class="font-bold text-blue-400">Blink / Blink+:</span> Instantly teleports you in the direction you are moving. (+) Teleports significantly further.</p>
                <p><span class="font-bold text-blue-400">Repel / Repel+:</span> Creates a shockwave that violently pushes nearby enemies away. (+) Larger shockwave and force.</p>
                <p><span class="font-bold text-blue-400">Titan / Titan+:</span> Grow huge. Stats multiply greatly for 8 seconds, followed by exhaustion (weakened stats). (+) No exhaustion, bigger stat multiply.</p>
                <p><span class="font-bold text-purple-400">Freeze+:</span> Instantly freezes the entire enemy team in place for 3 seconds.</p>
                <p><span class="font-bold text-purple-400">Motivator+:</span> HOLD ability key near enemies to DRAIN energy (fills bottom storage ring). HOLD near allies to BOOST their energy using your storage. Can be activated at any energy level.</p>
                <hr class="border-gray-700 my-2">
                <p><span class="font-bold text-yellow-400">Null (3 Slots):</span> Triggers an AOE pulse based on N-Rng stat. Enemies hit are "Nullified" (lose their abilities) for 10s. Having this equipped permanently expands your Stat Cap to 400.</p>
                <p><span class="font-bold text-yellow-400">Copycat (3 Slots):</span> Stealing the ball from an enemy copies their ability and <span class="text-red-400 font-bold">suppresses them for 10s</span>. You become the ability. You can only hold one stolen ability. Press Cycle to reset back to Copycat.</p>
                <p><span class="font-bold text-yellow-400">Adaptation (3 Slots):</span> Stealing the ball from an enemy permanently adds their ability to your library without suppressing them. You can steal infinite abilities and press Cycle to swap through your massive loadout.</p>
            </div>
        </div>
    </div>

    <!-- END GAME -->
    <div id="end-overlay" class="game-overlay" style="display: none;">
        <div class="modal-box text-center max-w-md">
            <h1 id="end-winner-text" class="text-4xl font-extrabold text-yellow-400 mb-4">GAME OVER!</h1>
            <div class="space-y-4 text-2xl font-mono mb-6">
                <div class="flex justify-between items-center p-4 rounded bg-blue-900/50 border border-blue-400"><span id="final-blue-name">Blue</span><span id="final-blue-score" class="font-bold">0</span></div>
                <div class="flex justify-between items-center p-4 rounded bg-red-900/50 border border-red-400"><span id="final-red-name">Red</span><span id="final-red-score" class="font-bold">0</span></div>
            </div>
            <button onclick="window.resetGameState()" class="w-full bg-green-600 hover:bg-green-500 py-3 rounded-lg font-bold text-lg shadow">Play Again</button>
        </div>
    </div>

    <!-- MAIN GAME UI -->
    <div class="flex-grow flex flex-col items-center justify-center w-full px-2">
        <div class="w-full max-w-5xl mb-2 p-2 bg-gray-800 rounded-lg shadow border border-gray-700 flex justify-between items-center text-center">
            <div class="text-blue-400 w-1/3">
                <h2 class="text-xl lg:text-2xl font-bold truncate px-2" id="current-blue-name">BLUE</h2>
                <p>Score: <span id="blue-score" class="font-bold text-white">0</span></p>
                <p class="text-xs text-gray-400">Pot: <span id="blue-potential" class="text-yellow-300">0</span></p>
            </div>
            <div class="text-white w-1/3 flex flex-col items-center cursor-pointer" onclick="window.togglePause()" title="Click to Pause">
                <p id="game-timer" class="text-3xl lg:text-4xl font-mono font-bold tracking-wider hover:text-yellow-300 transition">00:00</p>
                <span class="text-[10px] text-gray-500 uppercase tracking-widest bg-gray-700 px-2 rounded mt-1">ESC / START to Pause</span>
                <span id="network-status" class="text-[10px] text-yellow-400 uppercase tracking-widest mt-1 hidden">ONLINE</span>
            </div>
            <div class="text-red-400 w-1/3">
                <h2 class="text-xl lg:text-2xl font-bold truncate px-2" id="current-red-name">RED</h2>
                <p>Score: <span id="red-score" class="font-bold text-white">0</span></p>
                <p class="text-xs text-gray-400">Pot: <span id="red-potential" class="text-yellow-300">0</span></p>
            </div>
        </div>

        <div class="relative w-full max-w-5xl flex justify-center items-center">
            <canvas id="gameCanvas" width="1280" height="720"></canvas>
            <p id="game-message" class="absolute top-4 text-center w-full text-yellow-300 text-2xl font-extrabold drop-shadow-lg pointer-events-none"></p>
        </div>

        <div id="local-control-hints" class="hidden lg:grid grid-cols-2 gap-4 mt-4 w-full max-w-5xl text-center text-sm bg-gray-800 p-3 rounded-lg border border-gray-700">
            <div>
                <p class="text-blue-400 font-bold mb-1 border-b border-gray-600 pb-1">P1 (WASD / GAMEPAD 1)</p>
                <p class="text-gray-300 text-xs">Move: <span class="text-white">WASD / L-Stick</span> | Act: <span class="text-white">Space / A</span> | Switch: <span class="text-white">Q / Bumpers</span> | Ability: <span class="text-white">E / X</span> | Swap: <span class="text-white">C / B</span></p>
            </div>
            <div>
                <p class="text-red-400 font-bold mb-1 border-b border-gray-600 pb-1">P2 (ARROWS / GAMEPAD 2)</p>
                <p class="text-gray-300 text-xs">Move: <span class="text-white">Arrows / L-Stick</span> | Act: <span class="text-white">Enter / A</span> | Switch: <span class="text-white">R-Shift / Bumpers</span> | Ability: <span class="text-white">/ / X</span> | Swap: <span class="text-white">. / B</span></p>
            </div>
        </div>

        <div id="hero-control-hints" style="display:none;" class="mt-4 w-full max-w-5xl text-center text-sm bg-gray-800 p-3 rounded-lg border border-yellow-600">
