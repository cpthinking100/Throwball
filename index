        function buildPlayerObject(d, team, index, isHumanUid = null) {
            let startX = team==='blue' ? 100+Math.random()*300 : COURT_WIDTH-100-Math.random()*300;
            if(d.role==='goalkeeper') startX = team==='blue'? BLUE_HOLE.x+40 : RED_HOLE.x-40;
