            document.getElementById('hero-control-hints').style.display = game.playStyle === 'hero' ? 'block' : 'none';

            ball = { x: COURT_WIDTH/2, y: COURT_HEIGHT/2, radius: 8, color: '#fff', vx:0, vy:0, heldBy:null, lastHeldBy:null, cd:0 };
            game.scores = {blue:0, red:0}; game.pot = {blue:0, red:0}; game.potTimer = {blue:0, red:0}; game.freeze = {blue:0, red:0};
            game.startTime = performance.now(); game.lastTimestamp = performance.now(); game.state = 'playing';
            
            document.getElementById('network-status').style.display = 'block';
            UI.startUI.style.display = 'none'; UI.endUI.style.display = 'none';
            game.animId = requestAnimationFrame(gameLoop);
        }

        function startGameLocal() {
            game.timeSeconds = (parseInt(document.getElementById('game-time-input').value)||3)*60;
            game.blueName = document.getElementById('blue-team-name-input').value.trim()||'Blue Team'; game.redName = document.getElementById('red-team-name-input').value.trim()||'Red Team';
            document.getElementById('current-blue-name').innerText = game.blueName.toUpperCase(); document.getElementById('current-red-name').innerText = game.redName.toUpperCase();
            
