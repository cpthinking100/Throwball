        async function hostStartOnlineGame() {
            if(!roomDataCache) return;
            
            let bTeamRaw = []; let rTeamRaw = [];
            game.playStyle = roomDataCache.config.playStyle;

            if (game.playStyle === 'hero') {
                Object.keys(roomDataCache.players).forEach(uid => {
                    let pd = roomDataCache.players[uid]; 
                    if (!pd.isSpectator) { pd.uid = uid; if (pd.team === 'blue') bTeamRaw.push(pd); else rTeamRaw.push(pd); }
                });
                let bSize = parseInt(document.getElementById('blue-size-input').value) || 5;
                let rSize = parseInt(document.getElementById('red-size-input').value) || 5;
                while(bTeamRaw.length < bSize) bTeamRaw.push(generateRandomBotData('blue'));
                while(rTeamRaw.length < rSize) rTeamRaw.push(generateRandomBotData('red'));
                
                blueTeam = bTeamRaw.map((p,i) => buildPlayerObject(p, 'blue', i, p.uid));
                redTeam = rTeamRaw.map((p,i) => buildPlayerObject(p, 'red', i, p.uid));
            } else {
                blueTeam = loadTeam(UI.blueList, 'blue'); 
                redTeam = loadTeam(UI.redList, 'red');
                bTeamRaw = blueTeam; rTeamRaw = redTeam; 
                
                let hostPlayerInfo = roomDataCache.players[userId];
                if (!hostPlayerInfo.isSpectator) {
                     blueTeam.forEach(p => p.uid = userId); 
                }
                let clientUid = Object.keys(roomDataCache.players).find(id => id !== userId && !roomDataCache.players[id].isSpectator);
                if (clientUid) {
                     redTeam.forEach(p => p.uid = clientUid); 
                }
            }

            await updateDoc(roomRef, { status: 'playing', 'config.blueTeam': bTeamRaw, 'config.redTeam': rTeamRaw });
            startOnlineGameLoop();
        }

        function startOnlineGameLoop() {
            document.getElementById('current-blue-name').innerText = "BLUE TEAM"; document.getElementById('current-red-name').innerText = "RED TEAM";
            if (UI.mobileCheck.checked) UI.mobileControls.style.display = 'flex'; else UI.mobileControls.style.display = 'none';
            
