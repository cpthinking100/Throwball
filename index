        // --- DOM BUILDERS ---
        function generatePlayerRow(team, index, isHeroMode = false) {
            let roles = ['goalkeeper', 'defender', 'defender', 'playmaker', 'rusher', 'farmer'];
            let defaultRole = roles[Math.min(index, 5)];
            let name = FIRST_NAMES[Math.floor(Math.random() * FIRST_NAMES.length)];
            if(isHeroMode) defaultRole = 'rusher';

            const div = document.createElement('div');
            div.className = "flex flex-wrap items-center gap-1.5 bg-gray-800 p-2 rounded border border-gray-700 text-xs w-full";
            
            let defaultAbility = 'None';
            let rand = Math.random();
            if (rand > 0.95) defaultAbility = ['Copycat', 'Null', 'Adaptation'][Math.floor(Math.random() * 3)];
            else if (rand > 0.80) defaultAbility = ABILITIES.filter(a => a.includes('+'))[Math.floor(Math.random() * ABILITIES.filter(a => a.includes('+')).length)];
            else if (rand > 0.5) defaultAbility = ABILITIES.filter(a => a !== 'None' && !a.includes('+') && !['Copycat', 'Null', 'Adaptation'].includes(a))[Math.floor(Math.random() * ABILITIES.filter(a => a !== 'None' && !a.includes('+') && !['Copycat', 'Null', 'Adaptation'].includes(a)).length)];

            div.innerHTML = `
                ${isHeroMode ? '' : `<span class="font-mono text-gray-400 w-4">#${index+1}</span>`}
                <div class="flex items-center gap-1 border border-gray-600 rounded px-1"><input type="checkbox" class="show-name-check w-3 h-3" checked><input type="text" class="name-input w-12 bg-transparent text-white font-bold focus:outline-none" value="${name}"></div>
                <select class="role-select w-16 p-1 rounded bg-gray-700 focus:outline-none">${ROLES.map(r => `<option value="${r}" ${r===defaultRole?'selected':''}>${r.substr(0,4)}.</option>`).join('')}</select>
                <div class="flex flex-col gap-0.5 w-24">
                    ${[1,2,3].map(i => `<select class="ab-select p-0.5 rounded bg-gray-700 focus:outline-none ${i===1?getColor(defaultAbility):'text-gray-400'}">${ABILITIES.map(a => `<option value="${a}" ${a===(i===1?defaultAbility:'None')?'selected':''} class="${getColor(a)}">${a}</option>`).join('')}</select>`).join('')}
                </div>
                <div class="grid grid-cols-5 gap-1 items-center flex-grow pl-2">
                    ${['IQ','Spd','Stl','Kp','Chg'].map((l,i) => `<div class="flex items-center gap-1"><span class="text-gray-500 w-4">${l}</span><input type="number" min="1" max="150" value="50" class="stat-input w-9 text-center p-1 rounded bg-gray-700 focus:outline-none"></div>`).join('')}
                </div>
                <div class="flex items-center gap-1 null-range-container ml-1" style="${defaultAbility==='Null'?'display:flex;':'display:none;'}"><span class="text-purple-300">NRng</span><input type="number" min="1" max="150" value="50" class="stat-input null-input w-9 text-center p-1 rounded bg-gray-700 focus:outline-none"></div>
                <div class="ml-auto flex flex-col items-end"><div class="slots-display text-blue-300 font-bold mb-0.5">0/3</div><span class="tot-display text-green-400 font-bold">0/350</span></div>
            `;
            
            const selects = Array.from(div.querySelectorAll('.ab-select'));
            const inputs = Array.from(div.querySelectorAll('.stat-input'));
            const nullBox = div.querySelector('.null-range-container');
            let prevVals = selects.map(s => s.value);

            function updateRow(changedInput) {
                let cost = selects.reduce((s, el) => s + getCost(el.value), 0);
                let hasNull = selects.some(s => s.value === 'Null');
                nullBox.style.display = hasNull ? 'flex' : 'none';
                
                div.querySelector('.slots-display').innerText = `${cost}/3`;
                div.querySelector('.slots-display').className = cost > 3 ? 'slots-display text-red-500 font-bold' : 'slots-display text-blue-300 font-bold';

                let cap = hasNull ? BASE_STAT_CAP + 50 : BASE_STAT_CAP;
                let activeInputs = hasNull ? inputs : inputs.filter(i => !i.classList.contains('null-input'));
                let total = activeInputs.reduce((sum, i) => sum + (parseInt(i.value)||0), 0);

                if (UI.enforceCheck.checked && total > cap) {
                    let diff = total - cap;
                    if (changedInput && (parseInt(changedInput.value)||0) > diff) { changedInput.value = (parseInt(changedInput.value)||0) - diff; }
                    else {
                        let others = activeInputs.filter(i => i !== changedInput && (parseInt(i.value)||0) > 1);
                        while(diff > 0 && others.length > 0) {
                            let tgt = others[Math.floor(Math.random()*others.length)];
                            let v = parseInt(tgt.value)||0; if (v>1) { tgt.value = v-1; diff--; } else { others = others.filter(x=>x!==tgt); }
                        }
                    }
                    total = cap;
                }
                let totEl = div.querySelector('.tot-display');
                totEl.innerText = `${total}/${cap}`;
                totEl.className = `tot-display font-bold ${UI.enforceCheck.checked ? (total===cap?'text-green-400':'text-yellow-400') : 'text-gray-500'}`;
            }

            selects.forEach((s, i) => s.addEventListener('change', (e) => {
                let cost = selects.reduce((sum, el) => sum + getCost(el.value), 0);
                if (cost > 3) { e.target.value = prevVals[i]; alert("Max 3 Ability Slots!"); } 
                else { prevVals[i] = e.target.value; e.target.className = `ab-select w-full p-0.5 rounded bg-gray-700 focus:outline-none ${getColor(e.target.value)}`; updateRow(); }
            }));
            inputs.forEach(i => i.addEventListener('input', (e) => {
                let v=parseInt(e.target.value); if(v>150)e.target.value=150; if(v<1)e.target.value=1; updateRow(e.target);
            }));
            UI.enforceCheck.addEventListener('change', () => updateRow());
            
            let numStats = defaultAbility === 'Null' ? 6 : 5;
            let targetCap = defaultAbility === 'Null' ? BASE_STAT_CAP + 50 : BASE_STAT_CAP;
            let randStats = generateRandomStats(numStats, targetCap);
            inputs.forEach((inp, i) => { if(i < numStats) inp.value = randStats[i]; });
            updateRow(); return div;
        }

