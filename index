            else { 
                game.state = 'paused'; UI.pauseUI.style.display = 'flex'; cancelAnimationFrame(game.animId);
                const buildRoster = (teamArr, elId) => {
                    document.getElementById(elId).innerHTML = teamArr.map(p => `
                        <li class="flex justify-between items-center border-b border-gray-700 py-1">
                            <span><strong class="text-white">${p.name||'P'+(p.index+1)}</strong> <span class="text-gray-500 text-xs">(${p.role.substr(0,3).toUpperCase()})</span></span>
