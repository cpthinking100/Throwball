        window.toggleTutorial = () => { UI.tutorialUI.style.display = UI.tutorialUI.style.display === 'none' ? 'flex' : 'none'; };
        
        window.togglePause = () => {
            if (onlineMode !== 'local') return; 
            if (game.state === 'menu' || game.state === 'gameOver') return;
            if (game.state === 'paused') { 
                game.state = 'playing'; 
                UI.pauseUI.style.display = 'none'; 
                game.lastTimestamp = performance.now(); 
                requestAnimationFrame(gameLoop); 
