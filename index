            if(Math.random()>0.8) dAbil = 'None';
            let stats = generateRandomStats(5, BASE_STAT_CAP);
            return { name, role: defaultRole, abs: [dAbil], iq: stats[0]/100, spd: stats[1], stl: stats[2], kp: stats[3], chg: stats[4], nrng: 10, team: teamParam };
