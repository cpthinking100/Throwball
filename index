                game.p1.team = document.getElementById('p1-team-select').value; game.p2.team = document.getElementById('p2-team-select').value;
                
                if (game.p1.team !== 'none') { let t = game.p1.team==='blue'?blueTeam:redTeam; game.p1.index = Math.max(0, t.findIndex(p=>p.role!=='goalkeeper')); } else game.p1.index = -1;
                if (game.p2.team !== 'none') { let t = game.p2.team==='blue'?blueTeam:redTeam; let startI = t.findIndex((p,i) => p.role!=='goalkeeper' && (game.p1.team!==game.p2.team || game.p1.index!==i)); game.p2.index = startI !== -1 ? startI : 0; } else game.p2.index = -1;
                
                document.getElementById('local-control-hints').style.display = 'grid'; document.getElementById('hero-control-hints').style.display = 'none';
            } else {
                let h1D = getMyHeroConfig(true); let h2D = getMyHeroConfig(false);
                let p2TeamSel = UI.p2HeroTeam.value;
                let humans = [{ d: h1D, t: h1D.team, id: 'local_p1' }];
                if (p2TeamSel !== 'none') humans.push({ d: h2D, t: p2TeamSel, id: 'local_p2' });
                
                let bTeamRaw = []; let rTeamRaw = [];
                humans.forEach(h => { if(h.t==='blue') bTeamRaw.push(h); else rTeamRaw.push(h); });
                
                let bSize = parseInt(document.getElementById('blue-size-input').value) || 5; let rSize = parseInt(document.getElementById('red-size-input').value) || 5;
                while(bTeamRaw.length < bSize) bTeamRaw.push({ d: generateRandomBotData('blue'), t: 'blue', id: null });
                while(rTeamRaw.length < rSize) rTeamRaw.push({ d: generateRandomBotData('red'), t: 'red', id: null });
                
                blueTeam = bTeamRaw.map((p,i) => buildPlayerObject(p.d, 'blue', i, p.id));
                redTeam = rTeamRaw.map((p,i) => buildPlayerObject(p.d, 'red', i, p.id));
                
                let p1 = blueTeam.concat(redTeam).find(x=>x.uid==='local_p1'); game.p1.team = p1.team; game.p1.index = p1.index;
                if (p2TeamSel !== 'none') { let p2 = blueTeam.concat(redTeam).find(x=>x.uid==='local_p2'); game.p2.team = p2.team; game.p2.index = p2.index; } else { game.p2.team = 'none'; game.p2.index = -1; }
                
                document.getElementById('local-control-hints').style.display = 'none'; document.getElementById('hero-control-hints').style.display = 'block'; 
            }
            
            ball = { x: COURT_WIDTH/2, y: COURT_HEIGHT/2, radius: 8, color: '#fff', vx:0, vy:0, heldBy:null, lastHeldBy:null, cd:0 };
            game.scores = {blue:0, red:0}; game.pot = {blue:0, red:0}; game.potTimer = {blue:0, red:0}; game.freeze = {blue:0, red:0};
            game.startTime = performance.now(); game.lastTimestamp = performance.now(); game.state = 'playing';
            
            document.getElementById('network-status').style.display = 'none';
            UI.startUI.style.display = 'none'; UI.endUI.style.display = 'none';
            game.animId = requestAnimationFrame(gameLoop);
        }

        // --- Controls & Identification ---
        function isPlayerActive(team, index) {
            if (game.p1.team === team && game.p1.index === index) return 1;
            if (game.p2.team === team && game.p2.index === index) return 2;
            return 0;
        }

        document.addEventListener('keydown', (e) => {
            if (game.state === 'playing' || game.state === 'overtime') {
                if (['arrowup', 'arrowdown', 'arrowleft', 'arrowright', ' '].includes(e.key.toLowerCase())) e.preventDefault();
            }
            let k = e.key.toLowerCase(); keys[k] = true;
            if (k==='escape' || k==='p') window.togglePause();
            if (game.state !== 'playing' && game.state !== 'overtime') return;
            
            if (onlineMode !== 'client') {
                if (e.key === ' ') handleAction(1);
                if (k === 'q') switchPlayer(1);
                if (k === 'e') { let p = getActivePlayer(1); if(p && p.ability !== 'Motivator+') activateAbility(1); }
                if (k === 'c') cycleAbility(1);
                
                if (e.key === 'Enter') handleAction(2);
                if (e.key === 'Shift' && e.location === 2) switchPlayer(2);
                if (k === '/') { let p = getActivePlayer(2); if(p && p.ability !== 'Motivator+') activateAbility(2); }
                if (k === '.') cycleAbility(2);
            }
        });
        document.addEventListener('keyup', (e) => { keys[e.key.toLowerCase()] = false; if(e.key==='Shift') keys['shift']=false; });
        
        const bindTouch = (id, key, action) => {
            let el = document.getElementById(id); if(!el) return;
            el.addEventListener('touchstart', (e) => { e.preventDefault(); keys[key]=true; if(action && onlineMode!=='client')action(); });
            el.addEventListener('touchend', (e) => { e.preventDefault(); keys[key]=false; });
        };
        bindTouch('btn-up', 'w'); bindTouch('btn-down', 's'); bindTouch('btn-left', 'a'); bindTouch('btn-right', 'd');
        bindTouch('btn-act', ' ', () => {if(game.state==='playing')handleAction(1)});
        bindTouch('btn-switch', 'q', () => {if(game.state==='playing')switchPlayer(1)});
        bindTouch('btn-ability', 'e', () => {if(game.state==='playing') { let p = getActivePlayer(1); if(p && p.ability !== 'Motivator+') activateAbility(1); }});
        bindTouch('btn-cycle', 'c', () => {if(game.state==='playing')cycleAbility(1)});

        function getActivePlayer(pNum) {
            let pDef = pNum === 1 ? game.p1 : game.p2;
            if (pDef.team === 'none' || pDef.index === -1) return null;
            return (pDef.team === 'blue' ? blueTeam : redTeam)[pDef.index];
        }

        function cycleAbility(pNum, forceP) {
            let p = forceP || getActivePlayer(pNum); if(!p) return;
            if (p.timer>0 || p.dTimer>0 || p.activeAbility!=='None') { if(!forceP) displayMessage("Can't swap while active!", 1000); return; }
            if (p.isCC && p.ability!=='Copycat') {
                p.ability = 'Copycat'; p.charge=0; p.activeAbility='None'; if(!forceP) displayMessage(`${p.name||'P'+pNum} Reset!`, 1500);
            } else if (p.abs.length > 1 && !p.isNull) {
                p.curAbIdx = (p.curAbIdx+1)%p.abs.length; p.ability = p.abs[p.curAbIdx]; p.charge=0; p.activeAbility='None';
                if(!forceP) displayMessage(`${p.name||'P'+pNum} Swapped: ${p.ability}`, 1500);
            }
        }

        function throwBall(team, idx) {
            let p = (team === 'blue' ? blueTeam : redTeam)[idx];
            ball.heldBy = null; ball.lastHeldBy = { team: team, index: idx }; ball.cd = 500;
            let jitter = p.uid ? 0 : (1-p.iq)*0.3;
            let a = Math.atan2(p.dy || 0, p.dx || 1) + (Math.random()-0.5)*jitter;
            let speedMod = 1.0;
            if (p.timer > 0) { if (p.activeAbility === 'Sniper') speedMod = 1.5; if (p.activeAbility === 'Sniper+') speedMod = 2.5; }
            ball.vx = Math.cos(a) * THROW_SPEED * speedMod; ball.vy = Math.sin(a) * THROW_SPEED * speedMod;
        }

        function handleAction(pNum) {
            let p = getActivePlayer(pNum); if(!p) return;
            if(ball.heldBy && ball.heldBy.team===p.team && ball.heldBy.index===p.index) throwBall(p.team, p.index);
            else if (p.sCd<=0 && game.freeze[p.team]<=0) { p.steal=true; p.sTimer=0.3; p.sCd=1.0; }
        }

        function activateAbility(pNum, forceP) {
            let p = forceP || getActivePlayer(pNum); if(!p) return;
            if(game.freeze[p.team]>0 || p.isNull || p.ability === 'Motivator+') return;

            if (p.ability==='Null' && p.cd<=0) {
                p.cd=15; p.timer=0.5; p.activeAbility='Null'; let hit=0;
                (p.team==='blue'?redTeam:blueTeam).forEach(e=>{
                    if(getDist(p,e)<p.radius+15+p.nrng && !e.isNull){ e.stAbil=e.ability; e.ability='None'; e.isNull=true; e.nullTimer=10; e.activeAbility='None'; e.timer=0; e.dTimer=0; hit++; }
                });
                if(hit>0)displayMessage(`${p.name||'Player'} Nullified ${hit} Enemies!`, 2000);
            } else if (p.charge>=100) {
                p.charge=0; p.activeAbility=p.ability;
                if(UNTIL_STOLEN_ABILITIES.includes(p.ability)) p.timer=Infinity;
                else if(p.ability==='Titan') p.timer=8; else if(p.ability==='Titan+') p.timer=10;
                else if(p.ability.includes('Repel')) p.timer=5;
                else if(p.ability.includes('Blink')) { 
                    let d = p.ability.includes('+')?400:150; let l=Math.sqrt(p.dx*p.dx+p.dy*p.dy)||1; 
                    p.x+=(p.dx||0)/l*d; p.y+=(p.dy||0)/l*d; 
                    p.x=Math.max(p.radius, Math.min(COURT_WIDTH-p.radius, p.x)); p.y=Math.max(p.radius, Math.min(COURT_HEIGHT-p.radius, p.y)); 
                }
                else if(p.ability==='Freeze+') { game.freeze[p.team==='blue'?'red':'blue']=3.0; displayMessage("FREEZE+ ACTIVATED!", 2000); }
            }
        }

        function switchPlayer(pNum) {
            if (game.playStyle === 'hero') return; 
            let pDef = pNum === 1 ? game.p1 : game.p2;
            if (pDef.team === 'none') return;
            let teamArr = pDef.team === 'blue' ? blueTeam : redTeam;
            let otherDef = pNum === 1 ? game.p2 : game.p1;
            
            let best=-1, minD=Infinity;
            teamArr.forEach((p,i)=>{ 
                if(i===pDef.index) return;
                if(otherDef.team === pDef.team && otherDef.index === i) return; 
                if(p.role==='goalkeeper'&&getDist(p,ball)>150) return;
                let d=getDist(p,ball); if(d<minD){minD=d; best=i;} 
            });
            if(best===-1) {
                minD=Infinity;
                teamArr.forEach((p,i)=>{ if(otherDef.team === pDef.team && otherDef.index === i) return; let d=getDist(p,ball); if(d<minD){minD=d; best=i;} });
            }
            if(best!==-1) pDef.index = best;
        }

        function getLocalInputMap() {
            let gp = navigator.getGamepads ? navigator.getGamepads()[0] : null;
            return {
                up: keys['w'] || keys['arrowup'] || (gp && gp.buttons[12]?.pressed) || (gp && gp.axes[1] < -0.2),
                down: keys['s'] || keys['arrowdown'] || (gp && gp.buttons[13]?.pressed) || (gp && gp.axes[1] > 0.2),
                left: keys['a'] || keys['arrowleft'] || (gp && gp.buttons[14]?.pressed) || (gp && gp.axes[0] < -0.2),
                right: keys['d'] || keys['arrowright'] || (gp && gp.buttons[15]?.pressed) || (gp && gp.axes[0] > 0.2),
                act: keys[' '] || keys['enter'] || (gp && gp.buttons[0]?.pressed),
                abil: keys['e'] || keys['/'] || (gp && (gp.buttons[2]?.pressed || gp.buttons[7]?.pressed)),
                cyc: keys['c'] || keys['.'] || (gp && (gp.buttons[1]?.pressed || gp.buttons[3]?.pressed)),
                swt: keys['q'] || keys['shift'] || (gp && (gp.buttons[4]?.pressed || gp.buttons[5]?.pressed))
            };
        }

        // --- NETWORK SYNC HELPERS ---
        function serializeState() {
            return {
                b: blueTeam.map(p=>[Math.round(p.x), Math.round(p.y), p.activeAbility, p.isNull?1:0, Math.round(p.charge), Math.round(p.storedEnergy), p.motTarget?p.motTarget.index:-1, p.motTarget?p.motTarget.team==='blue'?1:0:-1, p.motType==='drain'?1:0, p.ability, p.steal?1:0]),
                r: redTeam.map(p=>[Math.round(p.x), Math.round(p.y), p.activeAbility, p.isNull?1:0, Math.round(p.charge), Math.round(p.storedEnergy), p.motTarget?p.motTarget.index:-1, p.motTarget?p.motTarget.team==='blue'?1:0:-1, p.motType==='drain'?1:0, p.ability, p.steal?1:0]),
                bl: [Math.round(ball.x), Math.round(ball.y), ball.heldBy?ball.heldBy.index:-1, ball.heldBy?(ball.heldBy.team==='blue'?1:0):-1],
                sc: [game.scores.blue, game.scores.red], pt: [game.pot.blue, game.pot.red],
                msg: UI.msg.innerText, p1i: game.p1.index, p2i: game.p2.index
            };
        }
        function applyNetworkState(s) {
            s.b.forEach((d, i) => {
                let p = blueTeam[i]; if(!p)return;
                p.x = d[0]; p.y = d[1]; p.activeAbility = d[2]; p.isNull = d[3]===1; p.charge = d[4]; p.storedEnergy = d[5]; 
                if(d[6]!==-1) p.motTarget = (d[7]===1?blueTeam:redTeam)[d[6]]; else p.motTarget=null;
                p.motType = d[8]===1?'drain':'boost'; p.ability = d[9]; p.steal = d[10]===1;
            });
            s.r.forEach((d, i) => {
                let p = redTeam[i]; if(!p)return;
                p.x = d[0]; p.y = d[1]; p.activeAbility = d[2]; p.isNull = d[3]===1; p.charge = d[4]; p.storedEnergy = d[5]; 
                if(d[6]!==-1) p.motTarget = (d[7]===1?blueTeam:redTeam)[d[6]]; else p.motTarget=null;
                p.motType = d[8]===1?'drain':'boost'; p.ability = d[9]; p.steal = d[10]===1;
            });
            ball.x = s.bl[0]; ball.y = s.bl[1]; 
            if (s.bl[2] !== -1) ball.heldBy = { index: s.bl[2], team: s.bl[3]===1?'blue':'red' }; else ball.heldBy = null;
            game.scores.blue = s.sc[0]; game.scores.red = s.sc[1]; game.pot.blue = s.pt[0]; game.pot.red = s.pt[1];
            game.netMsg = s.msg; game.p1.index = s.p1i; game.p2.index = s.p2i;
        }

        function pollGamepadsLocal() {
            const gps = navigator.getGamepads ? navigator.getGamepads() : [];
            for (let i = 0; i < 2; i++) {
                const gp = gps[i]; if (!gp) continue;
                let pDef = i === 0 ? game.p1 : game.p2;
                if (pDef.team === 'none') continue;
                let p = (pDef.team==='blue'?blueTeam:redTeam)[pDef.index];
                if (!p) continue;
                
                if (gp.buttons[0]?.pressed && !gpState[i].act) { gpState[i].act = true; if(game.state==='playing') handleAction(i+1); }
                else if (!gp.buttons[0]?.pressed) gpState[i].act = false;

                if ((gp.buttons[4]?.pressed || gp.buttons[5]?.pressed) && !gpState[i].swt) { gpState[i].swt = true; if(game.state==='playing') switchPlayer(i+1); }
                else if (!gp.buttons[4]?.pressed && !gp.buttons[5]?.pressed) gpState[i].swt = false;

                if ((gp.buttons[1]?.pressed || gp.buttons[3]?.pressed) && !gpState[i].cyc) { gpState[i].cyc = true; if(game.state==='playing') cycleAbility(i+1); }
                else if (!gp.buttons[1]?.pressed && !gp.buttons[3]?.pressed) gpState[i].cyc = false;

                if (gp.buttons[2]?.pressed && !gpState[i].abilTap) { 
                    gpState[i].abilTap = true; if(game.state==='playing' && p.ability !== 'Motivator+') activateAbility(i+1); 
                } else if (!gp.buttons[2]?.pressed) gpState[i].abilTap = false;
                
                if (gp.buttons[9]?.pressed && !gpState[i].start) { gpState[i].start = true; window.togglePause(); } 
                else if (!gp.buttons[9]?.pressed) gpState[i].start = false;
            }
        }

        // --- Game Loop ---
        function gameLoop(stamp) {
            try {
                let dt = (stamp - game.lastTimestamp) / 1000; game.lastTimestamp = stamp;
                if (dt > 0.1) dt = 0.1; if (dt < 0 || isNaN(dt)) dt = 0.016;

                if (game.state !== 'playing' && game.state !== 'overtime') { requestAnimationFrame(gameLoop); return; }

                if (onlineMode === 'local') {
                    pollGamepadsLocal();
                } else if (onlineMode === 'client') {
                    let curInp = getLocalInputMap();
                    let str = JSON.stringify(curInp);
                    if (str !== lastSentInputs && roomRef) { updateDoc(roomRef, { [`inputs.${userId}`]: curInp }).catch(e=>{}); lastSentInputs = str; }
                    if (game.netMsg) UI.msg.innerText = game.netMsg;
                } else if (onlineMode === 'host') {
                    Object.keys(remoteInputs).forEach(uid => {
                        if (uid === userId) return;
                        let inps = remoteInputs[uid] || {}; let prev = prevRemoteInputs[uid] || {};
                        let p = blueTeam.find(x=>x.uid===uid) || redTeam.find(x=>x.uid===uid);
                        if (p) {
                            if (inps.act && !prev.act) { throwBall(p.team, p.index); p.steal=true; p.sTimer=0.3; p.sCd=1.0; }
                            if (inps.abil && !prev.abil && p.ability !== 'Motivator+') activateAbility(0, p);
                            if (inps.cyc && !prev.cyc) cycleAbility(0, p);
                            if (inps.swt && !prev.swt && game.playStyle === 'team') {
                                let tArr = p.team==='blue'?blueTeam:redTeam; p.uid = null;
                                let nI = (p.index+1)%tArr.length; tArr[nI].uid = uid;
                            }
                        }
                        prevRemoteInputs[uid] = { ...inps };
                    });
                }

                if (onlineMode !== 'client') {
                    if(ball.cd>0) ball.cd-=dt*1000;
                    if(game.msgTimer>0){ game.msgTimer-=dt*1000; if(game.msgTimer<=0)UI.msg.innerText=''; }
                    if(game.freeze.blue>0) game.freeze.blue-=dt; if(game.freeze.red>0) game.freeze.red-=dt;

                    blueTeam.forEach(p => updatePlayerPhysics(p, 'blue', dt));
                    redTeam.forEach(p => updatePlayerPhysics(p, 'red', dt));
                    
                    if(ball.heldBy) { 
                        let p = (ball.heldBy.team==='blue'?blueTeam:redTeam)[ball.heldBy.index]; 
                        if (p) { ball.x=p.x; ball.y=p.y; ball.vx=0; ball.vy=0; }
                    } else { 
                        ball.x += (ball.vx || 0); ball.y += (ball.vy || 0); ball.vx*=0.98; ball.vy*=0.98; 
                        if(ball.x<8||ball.x>COURT_WIDTH-8)ball.vx*=-1; if(ball.y<8||ball.y>COURT_HEIGHT-8)ball.vy*=-1; 
                    }

                    checkInteractions(stamp);
                    
                    if (onlineMode === 'host' && stamp - lastSyncTime > 66 && roomRef) { 
                        updateDoc(roomRef, { state: serializeState() }).catch(e=>{}); lastSyncTime = stamp; 
                    }
                }

                let elapsed = (stamp - game.startTime)/1000; let rem = Math.max(0, Math.ceil(game.timeSeconds - elapsed));
                UI.timer.innerText = `${String(Math.floor(rem/60)).padStart(2,'0')}:${String(rem%60).padStart(2,'0')}`;
                
                if (onlineMode !== 'client' && rem<=0 && game.state==='playing') { 
                    if(game.scores.blue===game.scores.red){game.state='overtime'; displayMessage('OVERTIME!');} 
                    else endGame(game.scores.blue>game.scores.red?'Blue':'Red'); 
                }

                UI.blueScore.innerText = game.scores.blue; UI.bluePot.innerText = game.pot.blue;
                UI.redScore.innerText = game.scores.red; UI.redPot.innerText = game.pot.red;
                
                draw();
            } catch(e) { console.error("GameLoop Error:", e); }
            game.animId = requestAnimationFrame(gameLoop);
        }

        function updatePlayerPhysics(p, tName, dt) {
            if(p.isNull){ p.nullTimer-=dt; if(p.nullTimer<=0){ p.isNull=false; p.ability=p.stAbil; } }
            
            if(p.timer<=0 && p.dTimer<=0 && !p.isNull && p.activeAbility !== 'Motivator+') { 
                let chargeStatMult = 0.5 + ((p.chg||50) / 100);
                let baseRate = FAST_CHARGE_ABILITIES.includes(p.ability) ? 20 : 10;
                if(p.isCC && p.ability !== 'Copycat') baseRate *= 1.5; 
                p.charge = Math.min(100, p.charge + dt * baseRate * chargeStatMult); 
            }
            
            if(p.cd>0) p.cd-=dt; if(p.spCd>0) p.spCd-=dt;
            if(p.sTimer>0){ p.sTimer-=dt; if(p.sTimer<=0)p.steal=false; } if(p.sCd>0) p.sCd-=dt;
            
            if(p.timer>0 && p.timer!==Infinity){ p.timer-=dt; if(p.timer<=0){ if(p.activeAbility==='Titan') p.dTimer=4; else p.activeAbility='None'; } }
            if(p.dTimer>0){ p.dTimer-=dt; if(p.dTimer<=0)p.activeAbility='None'; }

            p.radius=p.bRad; p.spd=p.bSpd; p.stl=p.bStl; p.kp=p.bKp; p.motTarget=null;
            
            let isHoldingMot = false; let mx=0, my=0;

            if (onlineMode === 'local') {
                let pNum = isPlayerActive(p.team, p.index);
                if (pNum > 0) {
                    if(pNum===1){ if(keys['w'])my=-1; if(keys['s'])my=1; if(keys['a'])mx=-1; if(keys['d'])mx=1; if(keys['e'])isHoldingMot=true; }
                    else { if(keys['arrowup'])my=-1; if(keys['arrowdown'])my=1; if(keys['arrowleft'])mx=-1; if(keys['arrowright'])mx=1; if(keys['/'])isHoldingMot=true; }
                    const gp = navigator.getGamepads ? navigator.getGamepads()[pNum - 1] : null;
                    if (gp) {
                        if (Math.abs(gp.axes[0]) > 0.2) mx = gp.axes[0]; if (Math.abs(gp.axes[1]) > 0.2) my = gp.axes[1];
                        if (gp.buttons[12]?.pressed) my = -1; if (gp.buttons[13]?.pressed) my = 1;
                        if (gp.buttons[14]?.pressed) mx = -1; if (gp.buttons[15]?.pressed) mx = 1;
                        if (gp.buttons[2]?.pressed || gp.buttons[7]?.pressed) isHoldingMot = true; 
                    }
                } else { updateAI(p, tName, dt); mx=p.dx||0; my=p.dy||0; if (p.aiMotivatorActive) isHoldingMot = true; } 
            } else {
                if (p.uid === userId) {
                    let inps = getLocalInputMap();
                    if(inps.up)my=-1; if(inps.down)my=1; if(inps.left)mx=-1; if(inps.right)mx=1; isHoldingMot = inps.abil;
                } else if (p.uid) {
                    let inps = remoteInputs[p.uid] || {};
                    if(inps.up)my=-1; if(inps.down)my=1; if(inps.left)mx=-1; if(inps.right)mx=1; isHoldingMot = inps.abil;
                } else {
                    if (onlineMode === 'host') updateAI(p, tName, dt); 
                    mx=p.dx||0; my=p.dy||0; if (p.aiMotivatorActive) isHoldingMot = true;
                }
            }

            if (p.ability === 'Motivator+' && isHoldingMot && !p.isNull && game.freeze[tName] <= 0 && p.charge > 0) {
                p.activeAbility = 'Motivator+';
                p.charge = Math.max(0, p.charge - dt * 25); 

                let range = p.radius + 100; let target = null, minDist = Infinity;
                let candidates = p.team === 'blue' ? [...blueTeam, ...redTeam] : [...redTeam, ...blueTeam];
                
                candidates.forEach(e => {
                    if (e === p || getDist(p, e) >= range) return;
                    let isValid = false;
                    if (e.team !== p.team && e.charge > 0 && !e.isNull) isValid = true;
                    if (e.team === p.team && e.charge < 100 && e.ability !== 'None' && !e.isNull && p.storedEnergy > 0) isValid = true;
                    if (isValid) { let d = getDist(p, e); if (d < minDist) { minDist = d; target = e; } }
                });

                if (target) {
                    p.motTarget = target;
                    if (target.team !== p.team) {
                        p.motType = 'drain'; let actualDrain = Math.max(0, Math.min(dt * 60, target.charge));
                        target.charge -= actualDrain; p.storedEnergy = Math.min(150, p.storedEnergy + actualDrain);
                    } else { 
                        p.motType = 'boost'; let actualBoost = Math.max(0, Math.min(dt * 60, p.storedEnergy, 100 - target.charge));
                        p.storedEnergy -= actualBoost; target.charge += actualBoost;
                    }
                }
            } else if (p.activeAbility === 'Motivator+') p.activeAbility = 'None';

            let aSafe = p.activeAbility || '';
            if(aSafe.includes('Tank') && p.timer>0) p.kp += aSafe.includes('+')?100:50;
            if(aSafe==='Titan') { if(p.timer>0){p.radius*=1.5; p.spd*=2; p.kp*=2; p.stl*=2;} else if(p.dTimer>0){p.radius*=0.5; p.spd*=0.5; p.kp*=0.5; p.stl*=0.5;} }
            if(aSafe==='Titan+' && p.timer>0) { p.radius*=2; p.spd*=3; p.kp*=3; p.stl*=3; }
            if(aSafe.includes('Repel') && p.timer>0) {
                let frc = aSafe.includes('+')?600:300; let rRad = aSafe.includes('+')?150:60;
                (tName==='blue'?redTeam:blueTeam).forEach(e=>{
                    if(getDist(p,e)<p.radius+e.radius+rRad){ 
                        let vx=(e.x||0)-(p.x||0), vy=(e.y||0)-(p.y||0), l=Math.sqrt(vx*vx+vy*vy)||1; 
                        e.x+=vx/l*dt*frc; e.y+=vy/l*dt*frc; e.x=Math.max(e.radius, Math.min(COURT_WIDTH-e.radius, e.x)); e.y=Math.max(e.radius, Math.min(COURT_HEIGHT-e.radius, e.y)); 
                    }
                });
            }

            if(game.freeze[tName]>0) return;

            if(p.uid || (mx!==0 || my!==0)) {
                if(mx!==0||my!==0){ p.dx=mx; p.dy=my; }
                let b = p.uid ? (ball.heldBy?.team===tName&&ball.heldBy?.index===p.index?PLAYER_SPEED_BOOST:PLAYER_SPEED_NORMAL) : AI_SPEED;
                if(onlineMode==='local' && isPlayerActive(p.team, p.index)===0) b = AI_SPEED;
                let m = (aSafe==='Speedster'?1.2:(aSafe==='Speedster+'?1.6:1.0));
                let spd = b * (0.5+(p.spd||50)/100) * m * (p.steal?0.7:1);
                p.x += mx*spd; p.y += my*spd;
                p.x = Math.max(p.radius||15, Math.min(COURT_WIDTH-(p.radius||15), p.x || COURT_WIDTH/2));
                p.y = Math.max(p.radius||15, Math.min(COURT_HEIGHT-(p.radius||15), p.y || COURT_HEIGHT/2));
            }
        }

        function updateAI(p, t, dt) {
            let opp = t==='blue'?redTeam:blueTeam;
            let ally = t==='blue'?blueTeam:redTeam;
            
            if(p.jTimer>0) p.jTimer-=dt;
            if(p.cycleTimer>0) p.cycleTimer-=dt;
            p.aiMotivatorActive = false;

            if(p.abs.length>1 && !p.isNull && p.timer<=0 && p.dTimer<=0 && p.activeAbility==='None' && p.cycleTimer<=0) {
                let wantsToSwitch = false; let weHaveBall = ball.heldBy?.team === t; let enemyHasBall = ball.heldBy && ball.heldBy.team !== t;
                let isOffensive = ['Speedster', 'Speedster+', 'Sniper', 'Sniper+', 'Titan', 'Titan+', 'Blink', 'Blink+'].includes(p.ability);
                let isDefensive = ['Magnet', 'Magnet+', 'Tank', 'Tank+', 'Repel', 'Repel+', 'Freeze+', 'Null'].includes(p.ability);
                
                if (Math.random() < p.iq * dt * 2) {
                    if (weHaveBall && !isOffensive) wantsToSwitch = true;
                    if (enemyHasBall && !isDefensive) wantsToSwitch = true;
                    if (p.ability === 'Motivator+' && p.charge < 10 && p.storedEnergy < 10) wantsToSwitch = true;
                }
                if (wantsToSwitch || Math.random() < dt * 0.1) { cycleAbility(0, p); p.cycleTimer = 0.5; }
            }

            if(!p.isNull){
                if(p.ability==='Null' && p.cd<=0 && opp.find(e=>getDist(p,e)<p.radius+15+p.nrng && !e.isNull && e.ability!=='None')) activateAbility(0, p);
                else if(p.charge>=100 && ACTIVE_ABILITIES.includes(p.ability) && p.ability!=='Motivator+' && Math.random()<dt*0.3) activateAbility(0, p);
                else if(p.ability==='Motivator+' && p.charge > 0) {
                    let range = p.radius + 100;
                    let nearEnemy = opp.find(e => getDist(p, e) < range && e.charge > 0 && !e.isNull);
                    let nearAlly = ally.find(a => a !== p && getDist(p, a) < range && a.charge < 100 && a.ability !== 'None' && !a.isNull);
                    if (p.storedEnergy < 150 && nearEnemy) p.aiMotivatorActive = true;
                    else if (p.storedEnergy > 0 && nearAlly) p.aiMotivatorActive = true;
                }
            }

            let tx=COURT_WIDTH/2, ty=COURT_HEIGHT/2; let oHole = t==='blue'?BLUE_HOLE:RED_HOLE, eHole = t==='blue'?RED_HOLE:BLUE_HOLE;
            let hasBall = ball.heldBy?.team===t && ball.heldBy?.index===p.index;
            if(hasBall){ tx=eHole.x; ty=eHole.y; if(getDist(p, eHole)<300 && Math.random()<p.iq*0.05) throwBall(p.team, p.index); }
            else if(ball.heldBy?.team===t){ tx=eHole.x; ty=eHole.y; }
            else if(ball.heldBy){ tx=ball.x||tx; ty=ball.y||ty; if(getDist(p,ball)<40 && Math.random()<p.iq*0.1 && p.sCd<=0 && game.freeze[t]<=0) {p.steal=true; p.sTimer=0.3; p.sCd=1.0;} }
            else { tx=ball.x||tx; ty=ball.y||ty; }
            
            let vx=tx-(p.x||0), vy=ty-(p.y||0), l=Math.sqrt(vx*vx+vy*vy)||1; p.dx=vx/l; p.dy=vy/l;
            if(p.jTimer>0){ p.dx+=(Math.random()-0.5)*2; p.dy+=(Math.random()-0.5)*2; }
            let l2=Math.sqrt(p.dx*p.dx+p.dy*p.dy)||1; p.dx/=l2; p.dy/=l2;
        }

        function checkInteractions(stamp) {
            if(!ball.heldBy && ball.cd<=0) {
                [...blueTeam, ...redTeam].forEach(p => {
                    let r = p.radius + (p.steal?15:0) + (p.activeAbility==='Magnet'?20:(p.activeAbility==='Magnet+'?50:0));
                    if(getDist(p, ball) < r+ball.radius) {
                        let isSelf = ball.lastHeldBy && ball.lastHeldBy.team === p.team && ball.lastHeldBy.index === p.index;
                        if (ball.cd <= 0 || !isSelf) {
                            ball.heldBy = { team: p.team, index: p.index };
                            if (p.team==='blue') { if(game.pot.blue>0){game.pot.blue=0; displayMessage("Blue recovered! Pts lost.");} if(game.pot.red>0){game.scores.blue+=game.pot.red; displayMessage(`Blue recovered ${game.pot.red} Red pts!`); game.pot.red=0; game.potTimer.red=0;} }
                            else { if(game.pot.red>0){game.pot.red=0; displayMessage("Red recovered! Pts lost.");} if(game.pot.blue>0){game.scores.red+=game.pot.blue; displayMessage(`Red recovered ${game.pot.blue} Blue pts!`); game.pot.blue=0; game.potTimer.blue=0;} }
                        }
                    }
                });
            }
            if(ball.heldBy) {
                let car = (ball.heldBy.team==='blue'?blueTeam:redTeam)[ball.heldBy.index];
                if (!car) { ball.heldBy = null; return; } 
                (ball.heldBy.team==='blue'?redTeam:blueTeam).forEach(e => {
                    if(!e.steal) return;
                    let r = car.radius + e.radius + 15 + (e.activeAbility==='Magnet'?20:(e.activeAbility==='Magnet+'?50:0));
                    if(getDist(car, e) < r) {
                        let ch = 50 + (e.stl - car.kp)*0.5; ch = Math.max(10, Math.min(90, ch));
                        e.steal = false;
                        if(Math.random()*100 < ch) {
                            ball.heldBy = {team: e.team, index: e.index};
                            if(UNTIL_STOLEN_ABILITIES.includes(car.activeAbility)){ car.timer=0; car.activeAbility='None'; }
                            
                            let vAb = car.isNull ? car.stAbil : car.ability; let txt = "Steal Success!";
                            let attackerBase = e.isNull ? e.stAbil : e.baseAbility; let victimBase = car.isNull ? car.stAbil : car.baseAbility;
                            
                            if(attackerBase==='Copycat' && victimBase!=='Copycat' && victimBase!=='Adaptation' && vAb!=='None') {
                                e.ability = vAb; e.charge = 100; e.activeAbility='None'; txt = "CC SUPPRESSION!";
                                car.stAbil = vAb; car.ability = 'None'; car.isNull = true; car.nullTimer = 10; car.activeAbility='None'; car.timer=0; car.dTimer=0;
                            }
                            else if(attackerBase==='Adaptation' && e.spCd<=0 && vAb!=='None' && victimBase!=='Adaptation' && victimBase!=='Copycat') {
                                if(!e.abs.includes(vAb)){ e.abs.push(vAb); e.spCd=5; txt = "ADAPTED!"; }
                            }

                            let pts = ball.heldBy.team==='blue'?game.pot.blue:game.pot.red;
                            if(pts>0){ game.scores[e.team]+=pts; game.pot[ball.heldBy.team]=0; displayMessage(`${txt} + ${pts} pts!`); } else displayMessage(txt);
                        }
                    }
                });
            }
            if(!ball.heldBy && ball.lastHeldBy && game.state === 'playing') {
                if(ball.lastHeldBy.team==='blue' && getDist(ball,RED_HOLE)<ball.radius+RED_HOLE.radius){ let p=game.pot.blue+1; game.scores.blue+=p; game.pot.blue=0; displayMessage(`BLUE SCORES ${p} PTS!`); ball.x=COURT_WIDTH/2; ball.y=COURT_HEIGHT/2; ball.vx=0; ball.vy=0; ball.cd=0; ball.lastHeldBy=null; }
                else if(ball.lastHeldBy.team==='red' && getDist(ball,BLUE_HOLE)<ball.radius+BLUE_HOLE.radius){ let p=game.pot.red+1; game.scores.red+=p; game.pot.red=0; displayMessage(`RED SCORES ${p} PTS!`); ball.x=COURT_WIDTH/2; ball.y=COURT_HEIGHT/2; ball.vx=0; ball.vy=0; ball.cd=0; ball.lastHeldBy=null; }
            }
            if(ball.heldBy) {
                let t = ball.heldBy.team; let x = ball.x;
                if(t==='blue' && x>RED_ZONE.x){ if(game.potTimer.blue===0)game.potTimer.blue=stamp; else if(stamp-game.potTimer.blue>1500){game.pot.blue++; game.potTimer.blue=stamp; displayMessage("Blue +1 Pot");} }
                else if(t==='red' && x<BLUE_ZONE.x+BLUE_ZONE.w){ if(game.potTimer.red===0)game.potTimer.red=stamp; else if(stamp-game.potTimer.red>1500){game.pot.red++; game.potTimer.red=stamp; displayMessage("Red +1 Pot");} }
                else { game.pot[t]=0; game.potTimer[t]=0; }
            } else { game.potTimer={blue:0, red:0}; }
        }
        
        function endGame(w) { game.state='gameOver'; cancelAnimationFrame(game.animId); UI.endUI.style.display='flex'; document.getElementById('end-winner-text').innerText=`${w} WINS!`; document.getElementById('final-blue-score').innerText=game.scores.blue; document.getElementById('final-red-score').innerText=game.scores.red; }

        function draw() {
            ctx.clearRect(0,0,COURT_WIDTH,COURT_HEIGHT);
            ctx.fillStyle = 'rgba(59,130,246,0.1)'; ctx.fillRect(BLUE_ZONE.x, 0, BLUE_ZONE.w, COURT_HEIGHT);
            ctx.fillStyle = 'rgba(107,114,128,0.1)'; ctx.fillRect(NEUTRAL_ZONE.x, 0, NEUTRAL_ZONE.w, COURT_HEIGHT);
            ctx.fillStyle = 'rgba(239,68,68,0.1)'; ctx.fillRect(RED_ZONE.x, 0, RED_ZONE.w, COURT_HEIGHT);
            ctx.strokeStyle = 'rgba(255,255,255,0.15)'; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(NEUTRAL_ZONE.x,0); ctx.lineTo(NEUTRAL_ZONE.x,COURT_HEIGHT); ctx.moveTo(RED_ZONE.x,0); ctx.lineTo(RED_ZONE.x,COURT_HEIGHT); ctx.stroke();
            ctx.fillStyle='#111827'; ctx.strokeStyle='#fde047'; ctx.lineWidth=6;
            ctx.beginPath(); ctx.arc(BLUE_HOLE.x, BLUE_HOLE.y, BLUE_HOLE.radius, 0, Math.PI*2); ctx.fill(); ctx.stroke();
            ctx.beginPath(); ctx.arc(RED_HOLE.x, RED_HOLE.y, RED_HOLE.radius, 0, Math.PI*2); ctx.fill(); ctx.stroke();
            
            [...blueTeam, ...redTeam].forEach(p => {
                if (p.activeAbility === 'Motivator+' && p.motTarget && p.motTarget.x) {
                    ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p.motTarget.x, p.motTarget.y);
                    ctx.lineWidth = 4; ctx.strokeStyle = p.motType === 'drain' ? 'rgba(239, 68, 68, 0.6)' : 'rgba(16, 185, 129, 0.6)'; ctx.stroke();
                }
            });

            [...blueTeam, ...redTeam].forEach(p => {
                let a = p.activeAbility || '';
                if(a.includes('Repel') && p.timer>0) { ctx.fillStyle = p.team==='blue'?'rgba(59,130,246,0.2)':'rgba(239,68,68,0.2)'; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius+(a.includes('+')?150:60),0,Math.PI*2); ctx.fill(); }
                if(a==='Null' && p.timer>0) { ctx.fillStyle='rgba(192,132,252,0.4)'; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius+15+p.nrng,0,Math.PI*2); ctx.fill(); }
                
                if(game.freeze[p.team]>0) { ctx.fillStyle='rgba(165,243,252,0.5)'; ctx.fillRect(p.x-p.radius-5, p.y-p.radius-5, p.radius*2+10, p.radius*2+10); }
                else if(p.isNull) { ctx.fillStyle='rgba(0,0,0,0.6)'; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius,0,Math.PI*2); ctx.fill(); }
                if(p.steal && game.freeze[p.team]<=0){ ctx.fillStyle='rgba(255,255,255,0.3)'; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius+8,0,Math.PI*2); ctx.fill(); }
                
                ctx.fillStyle = p.team==='blue'?'#3b82f6':'#ef4444'; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius,0,Math.PI*2); ctx.fill();
                
                let cur = p.isNull ? p.stAbil : p.ability;
                let c = p.isNull ? '#374151' : (['Copycat','Adaptation','Null'].includes(p.baseAbility)?'#fbbf24':(cur.includes('+')?'#c084fc':(cur!=='None'?'#3b82f6':'#9ca3af')));
                
                let isMe = p.uid === userId && onlineMode !== 'local';
                if (isMe) { ctx.strokeStyle = '#fbbf24'; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius+12,0,Math.PI*2); ctx.stroke(); } 
                else if (onlineMode === 'local' && isPlayerActive(p.team, p.index) > 0 && !p.name) {
                    ctx.strokeStyle = isPlayerActive(p.team, p.index)===1 ? '#3b82f6' : '#ef4444'; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius+10,0,Math.PI*2); ctx.stroke();
                }

                if (cur === 'Motivator+') {
                    ctx.lineWidth = 3;
                    ctx.strokeStyle = '#10b981'; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius+3,Math.PI, 0); ctx.stroke(); 
                    if(p.charge>0){ ctx.strokeStyle = '#059669'; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius+3,Math.PI, Math.PI+(Math.PI*(p.charge/100))); ctx.stroke(); }
                    ctx.strokeStyle = '#f59e0b'; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius+3,0, Math.PI); ctx.stroke(); 
                    if(p.storedEnergy>0){ ctx.strokeStyle = '#fbbf24'; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius+3,0, (Math.PI*(p.storedEnergy/150))); ctx.stroke(); }
                } else {
                    ctx.strokeStyle = 'rgba(255,255,255,0.15)'; ctx.lineWidth=3; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius+3,0,Math.PI*2); ctx.stroke();
                    let pct=0, fc=c, show=false;
                    if(p.isNull){ show=true; pct=p.nullTimer/10; fc='#4b5563'; }
                    else if(p.dTimer>0){ show=true; pct=p.dTimer/4; fc='#ef4444'; }
                    else if(p.timer>0){ 
                        show=true; fc='#f59e0b';
                        if (p.timer === Infinity) { pct=1; } 
                        else {
                            let maxTime = p.activeAbility.includes('+') ? 10 : 8;
                            if (['Speedster', 'Speedster+', 'Magnet', 'Magnet+', 'Sniper', 'Sniper+', 'Tank', 'Tank+'].includes(p.activeAbility)) maxTime = p.activeAbility.includes('+') ? 7 : 5;
                            if (p.activeAbility === 'Repel' || p.activeAbility === 'Repel+') maxTime = 5;
                            if (p.activeAbility === 'Null') maxTime = 0.5;
                            pct = p.timer / maxTime;
                        }
                    }
                    else if(cur==='Null'&&p.cd>0){ show=true; pct=1-(p.cd/15); fc='rgba(251,191,36,0.4)'; }
                    else if(cur==='Copycat'){ show=true; pct=p.charge/100; if(pct>=1)fc='#10b981'; }
                    else if(cur!=='None' && !['Adaptation','Null'].includes(cur)){ show=true; pct=p.charge/100; if(pct>=1)fc='#10b981'; }

                    pct = isNaN(pct) ? 0 : Math.max(0, Math.min(1, pct));
                    if(show && pct>0){ ctx.strokeStyle=fc; ctx.beginPath(); ctx.arc(p.x,p.y,p.radius+3,-Math.PI/2, -Math.PI/2+(Math.PI*2*pct)); ctx.stroke(); }
                }
                
                ctx.fillStyle='rgba(255,255,255,0.8)'; ctx.font='bold 11px sans-serif'; ctx.textAlign='center'; ctx.fillText(p.role.substr(0,2).toUpperCase(), p.x, p.y+4);
                
                if(p.name) { 
                    ctx.fillStyle = isMe ? '#fbbf24' : 'rgba(255,255,255,0.9)'; 
                    ctx.font = (isMe?'bold ':'')+'10px sans-serif'; ctx.fillText(p.name, p.x, p.y+p.radius+16); 
                }
                
                let displayAbil = p.isNull ? 'NULLIFIED' : p.ability;
                ctx.fillStyle = p.isNull ? '#ef4444' : c; ctx.font='bold 10px sans-serif'; ctx.fillText(displayAbil.toUpperCase(), p.x, p.y-p.radius-8); 
            });

            ctx.fillStyle=ball.color; ctx.beginPath(); ctx.arc(ball.x||COURT_WIDTH/2,ball.y||COURT_HEIGHT/2,ball.radius,0,Math.PI*2); ctx.fill();
        }
    </script>
</body>
</html>
