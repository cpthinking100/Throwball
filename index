                        }
                        if (d.status === 'playing' && d.state && onlineMode === 'client') applyNetworkState(d.state);
                    });
                    document.getElementById('join-status-msg').innerText = "Connected!";
                } else document.getElementById('join-status-msg').innerText = "Room not found or full.";
            } catch(e) { console.error("Join Error:", e); document.getElementById('join-status-msg').innerText = "Connection failed."; }
