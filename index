                iq: d.iq, spd: d.spd, bSpd: d.spd, stl: d.stl, bStl: d.stl, kp: d.kp, bKp: d.kp, chg: d.chg, nrng: d.nrng,
                radius: 15, bRad: 15, vx:0, vy:0, dx: (team==='blue'?1:-1), dy:0,
                isCC: d.abs.includes('Copycat'), isAd: d.abs.includes('Adaptation'),
                charge: 0, storedEnergy: 0, aiMotivatorActive: false, motTarget: null, motType: null,
                timer: 0, dTimer: 0, cd: 0, spCd: 0, cycleTimer: 0, isNull: false, nullTimer: 0,
                steal: false, sTimer: 0, sCd: 0, jTimer: 0, rank: 99
            };
        }

        function loadTeam(listEl, team) {
