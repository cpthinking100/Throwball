        initAuth();

        // --- HELPER FUNCTIONS ---
        function getDist(a, b) { return Math.sqrt(Math.pow((a.x || 0)-(b.x || 0), 2)+Math.pow((a.y || 0)-(b.y || 0), 2)) || 0.1; }
        function isPlayerInZone(x, z) { return x>z.x && x<z.x+z.w; }
        function checkCollision(c1, c2) { return getDist(c1, c2) < (c1.radius || 15) + (c2.radius || 15); }
        function getCost(ab) { return ['Copycat', 'Null', 'Adaptation'].includes(ab) ? 3 : (ab.includes('+') ? 2 : (ab === 'None' ? 0 : 1)); }
        function getColor(ab) { return ['Copycat', 'Null', 'Adaptation'].includes(ab) ? 'text-yellow-400 font-bold' : (ab.includes('+') ? 'text-purple-400 font-bold' : (ab !== 'None' ? 'text-blue-400 font-bold' : 'text-gray-400')); }

        function generateRandomStats(numStats, total) {
            let s = new Array(numStats).fill(10); let r = total - (numStats * 10);
            while (r > 0) { let j = Math.floor(Math.random() * numStats); if (s[j] < 100) { let add = Math.min(r, Math.floor(Math.random() * 5) + 1); if (s[j]+add > 100) add = 100-s[j]; s[j] += add; r -= add; } }
            return s;
        }

        function generateRandomBotData(teamParam) {
            let defaultRole = ROLES[Math.floor(Math.random() * ROLES.length)];
            let name = FIRST_NAMES[Math.floor(Math.random() * FIRST_NAMES.length)] + " (Bot)";
